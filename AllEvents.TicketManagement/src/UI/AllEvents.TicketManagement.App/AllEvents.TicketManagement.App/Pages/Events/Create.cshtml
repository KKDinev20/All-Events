@page
@model AllEvents.TicketManagement.App.Pages.Events.CreateModel
@{
    ViewData["Title"] = "Create Event";
}

<h1 class="mb-4">Create Event</h1>

<form method="post" class="needs-validation" novalidate>
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <div class="invalid-feedback">
            <span asp-validation-for="Title"></span>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" />
        <div class="invalid-feedback">
            <span asp-validation-for="Location"></span>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" type="number" step="0.01" class="form-control" />
        <div class="invalid-feedback">
            <span asp-validation-for="Price"></span>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Category" class="form-label"></label>
        <select asp-for="Category" class="form-select">
            <option value="">Select Category</option>
            @foreach (var category in Enum.GetValues(typeof(EventCategory)).Cast<EventCategory>())
            {
                <option value="@category">@category</option>
            }
        </select>
        <div class="invalid-feedback">
            <span asp-validation-for="Category"></span>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="EventDate" class="form-label"></label>
        <input asp-for="EventDate" type="date" class="form-control" min="2000-01-01" />
        <div class="invalid-feedback">
            <span asp-validation-for="EventDate"></span>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="NrOfTickets" class="form-label"></label>
        <input asp-for="NrOfTickets" type="number" class="form-control" />
        <div class="invalid-feedback">
            <span asp-validation-for="NrOfTickets"></span>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
</form>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate-unobtrusive/3.2.11/jquery.validate.unobtrusive.min.js"></script>
    <script>
        (function () {
            'use strict'
            var forms = document.querySelectorAll('.needs-validation')
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
        })()
    </script>
}
