@page
@model AllEvents.TicketManagement.Web.Pages.GenerateReportModel

@{
    ViewData["Title"] = "Generate Sales Report";
}

<h2>Generate Sales Report</h2>

<form method="post" id="reportForm">
    <div class="form-group">
        <label for="category">Event Category</label>
        <select asp-for="Category" class="form-control" id="category" onchange="checkFormValidity()">
            <option value="">Select Category</option>
            @foreach (var category in Enum.GetValues(typeof(AllEvents.TicketManagement.Domain.Entities.EventCategory)))
            {
                <option value="@category">@category</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label for="fromDate">From Date</label>
        <input asp-for="FromDate" class="form-control" type="date" id="fromDate" onchange="checkFormValidity()" />
    </div>
    <div class="form-group">
        <label for="toDate">To Date</label>
        <input asp-for="ToDate" class="form-control" type="date" id="toDate" onchange="checkFormValidity()" />
    </div>
    <button type="submit" class="btn btn-primary" id="generateReportBtn" disabled>Generate Report</button>
</form>

@if (Model.ReportCsvData != null)
{
    <div class="mt-3">
        <a class="btn btn-success" href="@Url.Page("GenerateReport", null, new { fileName = "SalesReport.csv" })">Download Report</a>
    </div>
}

@section Scripts {
    <script>
        function checkFormValidity() {
            var category = document.getElementById("category").value;
            var fromDate = document.getElementById("fromDate").value;
            var toDate = document.getElementById("toDate").value;

            var isValid = category !== "" && fromDate !== "" && toDate !== "";

            document.getElementById("generateReportBtn").disabled = !isValid;
        }
    </script>
}