@page
@model AllEvents.TicketManagement.Web.Pages.GenerateReportModel

@{
    ViewData["Title"] = "Generate Sales Report";
}

<h2>Generate Sales Report</h2>

<form method="post">
    <div class="form-group">
        <label for="category">Event Category</label>
        <select asp-for="Category" class="form-control" id="category">
            <option value="">Select Category</option>
            @foreach (var category in Enum.GetValues(typeof(AllEvents.TicketManagement.Domain.Entities.EventCategory)))
            {
                <option value="@category">@category</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label for="fromDate">From Date</label>
        <input asp-for="FromDate" class="form-control" type="date" id="fromDate" />
    </div>
    <div class="form-group">
        <label for="toDate">To Date</label>
        <input asp-for="ToDate" class="form-control" type="date" id="toDate" />
    </div>
    <button type="submit" class="btn btn-primary">Generate Report</button>
</form>

@if (Model.ReportCsvData != null)
{
    var timestamp = DateTime.Now.ToString("yyyyMMddHHmmss");
    var fileName = $"SalesReport_{Model.Category}_{timestamp}.csv";

    <div class="mt-3">
        <a class="btn btn-success" href="@Url.Page("GenerateReport", null, new { fileName = fileName })">Download Report</a>
    </div>
}
